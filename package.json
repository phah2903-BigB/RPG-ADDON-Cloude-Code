{
  "name": "chroniken-des-weltenbaums",
  "version": "1.0.1",
  "private": true,
  "description": "RPG-Add-on für Minecraft Bedrock (Realm, PS5, Android)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "gen": "node tools/gen.mjs",
    "textures": "python3 -I tools/textures/main.py",
    "validate": "node tools/validate.mjs",
    "all": "npm run typecheck && npm run gen && npm run textures && npm run build && npm run validate"
  },
  "devDependencies": {
    "@minecraft/server": "2.8.0",
    "@minecraft/server-ui": "2.1.0",
    "@minecraft/vanilla-data": "1.26.60",
    "@types/node": "22.10.2",
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
