{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "cdw:npc",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "cdw:variant": {
          "type": "int",
          "range": [
            0,
            7
          ],
          "default": 0,
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "cdw_npc",
          "npc",
          "inanimate"
        ]
      },
      "minecraft:health": {
        "value": 100,
        "max": 100
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:persistent": {},
      "minecraft:nameable": {
        "always_show": true,
        "allow_name_tag_renaming": false
      },
      "minecraft:movement": {
        "value": 0
      },
      "minecraft:knockback_resistance": {
        "value": 1
      },
      "minecraft:fire_immune": true,
      "minecraft:behavior.look_at_player": {
        "priority": 1,
        "look_distance": 8,
        "probability": 0.9
      },
      "minecraft:behavior.random_look_around": {
        "priority": 2
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "event": "cdw:talk"
            },
            "interact_text": "action.interact.cdw_talk"
          }
        ]
      }
    },
    "events": {
      "cdw:talk": {}
    }
  }
