{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "cdw:verdorrter_priester",
      "population_control": "monster"
    },
    "conditions": [
      {
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:weight": {
          "default": 16
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 2
        },
        "minecraft:biome_filter": {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "desert"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "mesa"
            }
          ]
        },
        "minecraft:spawns_on_surface": {},
        "minecraft:density_limit": {
          "surface": 3
        },
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 7,
          "adjust_for_weather": true
        }
      }
    ]
  }
}
