{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "cdw:frosttroll",
      "population_control": "monster"
    },
    "conditions": [
      {
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:weight": {
          "default": 8
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 1
        },
        "minecraft:biome_filter": {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "frozen"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "cold"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "mountains"
            }
          ]
        },
        "minecraft:spawns_on_surface": {},
        "minecraft:density_limit": {
          "surface": 1
        }
      }
    ]
  }
}
