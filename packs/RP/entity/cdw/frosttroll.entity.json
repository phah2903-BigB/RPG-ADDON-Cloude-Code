{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "cdw:frosttroll",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/cdw/entity/frosttroll"
      },
      "geometry": {
        "default": "geometry.cdw.troll"
      },
      "animations": {
        "idle": "animation.cdw.troll.idle",
        "walk": "animation.cdw.troll.walk",
        "attack": "animation.cdw.troll.attack"
      },
      "scripts": {
        "animate": [
          "idle",
          {
            "walk": "q.modified_move_speed > 0.02"
          },
          {
            "attack": "v.attack_time > 0.0"
          }
        ],
        "scale": "q.property('cdw:elite') ? 1.2 : 1.0"
      },
      "render_controllers": [
        "controller.render.cdw.mob"
      ],
      "spawn_egg": {
        "base_color": "#7a9bb0",
        "overlay_color": "#dff2ff"
      }
    }
  }
}
